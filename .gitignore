# GoReleaser build output.
/dist/

# A locally built binary. bin/ is not ignored: bin/prime is a tracked script.
/caf
/caf.exe

# The local stack `caf dev` renders. It is generated from cafaye.yml and
# rewritten on every run, so a checked-in copy is a copy that drifts.
caf.dev.compose.yaml

# Test and coverage output.
coverage.txt
*.out
*.test

# core's gate checker writes the gate's own output here when it is run with
# `--log-dir .log`, which is how tests/gate-declaration-self-test.sh runs its
# first two controls: they check the real repository, not a copy, because a
# four-file copy cannot run `go mod download`. The log is the operator's
# evidence and is deliberately never committed.
.log/

# Local environment.
.env
.env.*
!.env.example

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
